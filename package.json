{
  "name": "cgnews",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "White",
    "url": "https://github.com/WhiteDG"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build && node scripts/copy-prisma-wasm.mjs",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && OPEN_NEXT_DEPLOY=true wrangler deploy",
    "cf:upload": "npm run cf:build && OPEN_NEXT_DEPLOY=true wrangler versions upload",
    "cf:copy-prisma-wasm": "node scripts/copy-prisma-wasm.mjs",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply cgnews --local",
    "db:migrate:remote": "wrangler d1 migrations apply cgnews --remote",
    "start": "next start",
    "seed": "node prisma/seed.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint-staged": "lint-staged",
    "preview": "next build && next start",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run typecheck && npm run lint",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "deploy:prod": "npm run check && npm run cf:build && npm run db:migrate:remote && OPEN_NEXT_DEPLOY=true wrangler deploy && npm run smoke:prod",
    "format:write": "prettier --write \"**/*.{js,ts,jsx,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{js,ts,jsx,tsx,mdx}\" --cache",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.31.6",
    "@hookform/resolvers": "^3.3.4",
    "@libsql/client": "0.8.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@prisma/adapter-d1": "6.15.0",
    "@prisma/adapter-libsql": "6.15.0",
    "@prisma/client": "^6.15.0",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-hover-card": "^1.0.7",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "cheerio": "1.0.0-rc.12",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.11",
    "lucide-react": "^0.363.0",
    "next": "^15.5.18",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.50.1",
    "sonner": "^1.4.41",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.2.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.2.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^18.2.77",
    "@types/react-dom": "^18.2.25",
    "@typescript-eslint/parser": "^8.63.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.41.0",
    "eslint-config-next": "^15.5.18",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-tailwindcss": "^3.15.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "postcss": "^8",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "pretty-quick": "^4.0.0",
    "prisma": "^6.15.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.4.2",
    "wrangler": "^4.110.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,mdx}": [
      "eslint --fix",
      "prettier --write \"**/*.{js,ts,jsx,tsx,mdx}\" --cache --ignore-unknown"
    ]
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
